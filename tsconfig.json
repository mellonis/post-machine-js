{
  "extends": "@tsconfig/recommended",
  "compilerOptions": {
    "target": "ES2020",
    "module": "ES2020",
    "declaration": true,
    "strict": true,
    "moduleResolution": "bundler",
    "skipLibCheck": true,
    "types": ["vitest/globals", "node"]
  },
  "exclude": [
    "packages/*/dist/**/*"
  ]
}
